# Greenwash Environment Configuration
# Copy this file to .env for local development

# Node Server Environment
PORT=3001
NODE_ENV=development

# Optional Integrations (Safe fallbacks exist when omitted)
# Gemma inference endpoint:
# Option A (Local Dev Mock): http://localhost:3001/api/gemma/mock
# Option B (Local Real Ollama): http://localhost:11434 (after running `ollama run gemma:2b`)
GEMMA_ENDPOINT=http://localhost:3001/api/gemma/mock
GEMMA_MODEL=gemma:2b

# Entire CLI / Provenance session path
ENTIRE_SESSION_PATH=

# Sentry Agent Tracing
# Format: https://<publicKey>@<host>/<projectId> (e.g. https://examplePublicKey@o0.ingest.sentry.io/0)
# Leave blank for local development (audits run with in-memory telemetry, reports 'Not configured')
SENTRY_DSN=
# Trace sampling rate between 0.0 and 1.0 (defaults to 1.0 for dev/tests, configure 0.1 to 0.2 in high-volume production)
SENTRY_TRACES_SAMPLE_RATE=1.0

# MongoDB Atlas URI (falls back to in-memory store if unset)
# Format: mongodb+srv://username:password@cluster.mongodb.net
# NEVER commit real credentials. Use Atlas Database User with least-privilege read/write role.
# Leave blank to use ephemeral local in-memory history (default for development).
MONGODB_URI=

# MongoDB Atlas Database and Collection names (optional, defaults shown)
# MONGODB_DATABASE=greenwash
# MONGODB_COLLECTION=audit_history

# Smoke-test your credentials locally:
#   npm run greenwash -- test-mongo

