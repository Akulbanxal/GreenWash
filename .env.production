# Greenwash Production Deployment Environment Configuration
# Copy or supply these environment variables to your deployment environment (Docker, Cloud VM, Render, Fly.io, etc.)

# Port and Node Environment
PORT=3001
NODE_ENV=production

# Gemma Inference Endpoint
# Set to your Ollama host, e.g., http://ollama:11434, http://localhost:11434, or your private model server
GEMMA_ENDPOINT=http://localhost:11434
GEMMA_MODEL=gemma:2b

# Agent Session Provenance Path (checked-in default or external live log path)
ENTIRE_SESSION_PATH=fixtures/sessions/sanitized-sample-session.json

# MongoDB Atlas Persistence (uncomment and supply connection string to persist audit history)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net
# Leave empty for ephemeral in-memory storage fallback.
# MONGODB_URI=
MONGODB_DATABASE=greenwash
MONGODB_COLLECTION=audit_history

# Sentry Distributed Tracing (uncomment and supply DSN to enable OpenTelemetry tracing)
# Format: https://<publicKey>@<host>/<projectId>
# Leave empty for local tracing only.
# SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
